# Copy only for a new environment; never overwrite an existing .env.
# PostgreSQL: create a dedicated database/role, then enter its password locally.
DATABASE_URL=postgresql+psycopg://se_learning_app:YOUR_PASSWORD@127.0.0.1:5432/se_learning
# Optional isolated SQLite fallback: sqlite:///./learning.db
SEED_PASSWORD=CHANGE_TO_AT_LEAST_8_CHARACTERS
SESSION_HOURS=12
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]
# Explicit local-only legacy demo; disable before sharing/deploying the application.
ENABLE_DEV_ROUTES=false
ENABLE_DEMO=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Used only by the optional Docker database, not the native PostgreSQL service.
# POSTGRES_PASSWORD=YOUR_DOCKER_DATABASE_PASSWORD
