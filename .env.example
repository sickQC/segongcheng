# 默认 SQLite 文件位于 backend/learning.db；无需数据库服务。
DATABASE_URL=sqlite:///./learning.db
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
ENABLE_DEMO=true

# M7 检索层的向量后端：hashing（默认，本地哈希 TF-IDF，零下载、离线可跑）
# 可选 st（sentence-transformers 本地模型）或 openai（兼容 /embeddings 接口）。
# 切换后端后需要重建索引：python scripts/build_rag_index.py
# SE_RAG_EMBED_BACKEND=hashing
# SE_RAG_ST_MODEL=BAAI/bge-small-zh-v1.5

# 后续启动 deploy/compose.yaml 后可改为：
# DATABASE_URL=postgresql+psycopg://se_learning:本机设置的密码@127.0.0.1:5432/se_learning
# POSTGRES_PASSWORD=请自行设置
