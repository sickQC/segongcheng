# Copy to deploy/.env.deploy only if that file does not exist.
# This configuration is independent of the repository-root .env.
# Use single quotes to preserve literal $ characters in Compose env files.
DEPLOY_DB_PASSWORD='CHANGE_ME_DATABASE_PASSWORD'
DEPLOY_SEED_PASSWORD='CHANGE_ME_LOGIN_PASSWORD'
DEPLOY_BIND_ADDRESS=127.0.0.1
DEPLOY_PORT=8080
DEPLOY_ALLOWED_ORIGINS='["http://127.0.0.1:8080","http://localhost:8080"]'
DEPLOY_COOKIE_SECURE=false
# Optional; basic login, quizzes and recommendation rules work without a model.
DEPLOY_LLM_API_KEY=
DEPLOY_LLM_BASE_URL=https://api.deepseek.com
DEPLOY_LLM_MODEL=deepseek-flash
DEPLOY_C_LLM_MODEL=
